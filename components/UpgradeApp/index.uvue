<script setup lang="uts">
	import { Upgrade_Dir } from "@/const/index.uts"
	import { showToast } from "@/utils/index.uts"
	import { deleteFile } from "@/utils/file.uts"

	const emit = defineEmits(['close'])

	const props = defineProps({
		version: {
			type: String,
			default: '1.0.0'
		}
	})

	const showDialog = ref(true)
	const currentProgress = ref(0)

	// 关闭
	const handleCancel = () => {
		emit('close')
	}

	// 现在下载安装
	const handleSure = () => {
		uni.downloadFile({
			url: `https://github.com/xzzfxz/net-player/releases/download/${props.version}/${props.version}.apk`,
			filePath: Upgrade_Dir,
			success(result) {
				const appPath = result.tempFilePath as string;
				uni.installApk({
					filePath: appPath,
				})
				handleCancel()
			},
			fail(error) {
				console.log("下载失败", error)
				showToast("apk下载失败", "error")
			}
		}).onProgressUpdate((progressRes) => {
			currentProgress.value = progressRes.progress
		})
	}
</script>

<template>
	<page-container :show="showDialog" position="center" :round="true" overlay-style="pointer-events: none;"
		custom-style="background-color: transparent; align-items: center; justify-content: center;"
		@beforeleave="handleCancel">
		<view class="dialog-panel">
			<view class="dialog-content">
				<text class="dialog-title">是否现在升级?</text>
				<view style="margin-left: 20px;">最新版本：{{props.version}}</view>
				<view class="progress-container">
					<progress class="progress" :percent="currentProgress" :stroke-width="3" />
				</view>
			</view>
			<view class="deal-container">
				<view class="deal-btn" hover-class="deal-btn-hover" @tap="handleCancel">
					<text class="deal-btn-text">取消</text>
				</view>
				<view class="deal-btn right-deal-btn" hover-class="deal-btn-hover" @tap="handleSure">
					<text class="deal-btn-text">确定</text>
				</view>
			</view>
		</view>
	</page-container>
</template>

<style lang="scss">
	.dialog-panel {
		width: 300px;
		height: 220px;
		background-color: #ffffff;
		border-radius: 12px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.dialog-content {
		height: 0;
		flex-grow: 1;
	}

	.dialog-title {
		width: 300px;
		padding: 20px;
		font-weight: 700;
		text-align: center;
	}

	.progress-container {
		width: 260px;
		margin: 0 auto;
		padding-top: 10px;
		padding-bottom: 20px;
	}

	.deal-container {
		width: 300px;
		height: 48px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		flex-direction: row;

		.deal-btn {
			flex: 1;
			height: 48px;
			background-color: transparent;
			border-top: 1px solid #eeeeee;
			align-items: center;
			justify-content: center;
		}

		.right-deal-btn {
			border-left: 1px solid #eeeeee;
		}

		.deal-btn-hover {
			background-color: #f3f3f3;
		}

		.deal-btn-text {
			color: #333333;
		}
	}
</style>
