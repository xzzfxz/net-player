import type { ISongItem } from "@/types";
import { getFileUrl, showToast } from "@/utils"
import { Download_Dir, Emit_Name } from "@/const"
import {
	mainStore,
	setSongLocalPath,
	currentPlayList,
	addDownloadFailedSong,
	removeDownloadFailedSong
} from "@/store";
import { playStore, setIsPlaying, setCurrentSong, handleAddToPlayedList, setAutoScrollToPlay } from "@/store/play";

export const audioBgManager = uni.getBackgroundAudioManager();

// 播放中
audioBgManager.onPlay(() => {
	setIsPlaying(true)
})

// 暂停
audioBgManager.onPause(() => {
	setIsPlaying(false)
})

// 停止
audioBgManager.onStop(() => {
	setIsPlaying(false)
})

// 播放结束
audioBgManager.onEnded(() => {
	setIsPlaying(false)
	handlePlayNext()
})

// 播放错误
audioBgManager.onError((error) => {
	setIsPlaying(false)
	showToast("播放失败", "error")
	handlePlayNext()
})

// 播放进度更新
audioBgManager.onTimeUpdate((res) => {
	uni.$emit(Emit_Name.PLAY_TIME_UPDATE as string, Math.round(audioBgManager.currentTime))
})

// 上一曲事件
audioBgManager.onPrev(() => {
	// 上一曲
	handlePlayPre()
})

// 下一曲事件
audioBgManager.onNext(() => {
	handlePlayNext()
})

// 改变url并开始播放
export const startPlayAudio = (src : string, songData : ISongItem) => {
	// 添加到播放列表
	handleAddToPlayedList(songData)
	audioBgManager.src = src;
	audioBgManager.title = songData.name;
	audioBgManager.singer = songData.author;
	audioBgManager.cache = false;
	handlePlay()
}

// 播放
export const handlePlay = () => {
	if (playStore.currentSong == null) {
		handlePlayNext()
		return;
	}
	audioBgManager.play()
}

// 暂停
export const handlePause = () => {
	if (playStore.currentSong == null || !playStore.isPlaying) {
		return;
	}
	audioBgManager.pause()
}

// 跳转到播放位置
export const handleSeek = (pos : number) => {
	if (playStore.currentSong == null) {
		return;
	}
	audioBgManager.seek(pos)
}

// 每次调用都会重新获取下载 URL。所有下载入口共用此方法，保证失败记录状态一致。
const downloadSong = async (songData : ISongItem) : Promise<string> => {
	const url = await getFileUrl(songData.id, songData.pickCode)
	if (url == "") {
		addDownloadFailedSong(songData)
		return ""
	}
	return new Promise(resolve => {
		uni.downloadFile({
			url,
			filePath: Download_Dir,
			success(result) {
				const localPath = result.tempFilePath as string
				if (result.statusCode < 200 || result.statusCode >= 300 || localPath == "") {
					console.log("下载响应异常，状态码：", result.statusCode)
					addDownloadFailedSong(songData)
					resolve("")
					return
				}
				setSongLocalPath(songData.id, localPath)
				removeDownloadFailedSong(songData.id)
				resolve(localPath)
			},
			fail(error) {
				console.log("下载失败", error)
				addDownloadFailedSong(songData)
				resolve("")
			}
		})
	})
}

// 失败列表重试：忽略已有本地路径，强制重新获取 URL 并下载
export const retryDownloadSong = async (songData : ISongItem) : Promise<boolean> => {
	const localPath = await downloadSong(songData)
	if (localPath == "") {
		showToast("下载失败", "error")
		return false
	}
	showToast("下载成功", "success")
	return true
}

// 准备播放
export const handlePreparePlay = async (songData : ISongItem, autoScrollPlay : boolean) => {
	setCurrentSong(songData)
	setAutoScrollToPlay(autoScrollPlay)
	// 先判断本地是否已下载
	let lastUrl = mainStore.songLocalPath[songData.id]
	uni.$emit(Emit_Name.SCROLL_TO_PLAY as string, songData.id, false)
	if (lastUrl != null) {
		// 已下载，直接使用本地url
		lastUrl = lastUrl as string;
		removeDownloadFailedSong(songData.id)
		startPlayAudio(lastUrl, songData)
		return;
	}
	// 获取文件下载地址并下载到本地
	lastUrl = await downloadSong(songData)
	if (lastUrl == "") {
		showToast("下载失败", "error")
		if (songData.id == playStore.currentSong?.id) {
			handlePlayNext()
		}
		return
	}
	if (songData.id == playStore.currentSong?.id) {
		startPlayAudio(lastUrl, songData)
	}
}

// 上一曲
export const handlePlayPre = () => {
	if (playStore.playedList.length <= 1) {
		// 没有上一曲了，不处理
		return;
	}
	playStore.playedList.pop()
	const lastSong = playStore.playedList.pop()!
	handlePreparePlay(lastSong, true)
}

// 下一曲
export function handlePlayNext () {
	// 先判断是否为单曲循环
	if (mainStore.playMode == "single") {
		if (playStore.currentSong != null) {
			handlePreparePlay(playStore.currentSong!, true)
			return;
		}
	}
	// 是否有待播放列表
	if (playStore.waitList.length > 0) {
		const songData = playStore.waitList.shift()!
		handlePreparePlay(songData, true)
		return;
	}
	// 顺序播放
	if (mainStore.playMode == "list") {
		const index = currentPlayList.value.findIndex(item => item.id == playStore.currentSong?.id)
		if (index == -1) {
			return;
		}
		let nextIndex = index + 1
		if (nextIndex >= currentPlayList.value.length) {
			nextIndex = 0
		}
		const songData = currentPlayList.value[nextIndex]
		handlePreparePlay(songData, true)
		return;
	}
	// 随机播放
	let nextIndex = Math.floor(Math.random() * currentPlayList.value.length)
	const songData = currentPlayList.value[nextIndex]
	handlePreparePlay(songData, true)
}
