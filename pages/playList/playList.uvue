<script setup lang="uts">
	import NavigationBar from '@/components/NavigationBar/index.uvue'
	import SongItem from "./components/songItem.uvue"
	import PathDialog from "./components/pathDialog.uvue"
	import { IPathStack, IGroupItem, ISongItem } from '@/types'
	import {
		handleUpdateGroupInfo,
		setGroupSongMap,
		mainStore,
		setCurrentGroup,
		handleDeleteGroupSong,
		clearDownloadFailedList
	} from '@/store'
	import { fetchFolders } from "@/api"
	import { showToast, deleteFile } from '@/utils'
	import Icon from '@/components/Icon/index.uvue'
	import { Font_Info } from '@/const/font'
	import PlayControl from '@/components/PlayControl/index.uvue'
	import { Emit_Name } from "@/const"
	import { playStore } from "@/store/play.uts"
	import { handlePreparePlay } from '@/utils/playAudio.uts'
	import { LayoutItem } from '@/uni_modules/uni-recycle-view/common/types.uts'

	const filterValue = ref("")
	const showPathDialog = ref(false)
	const groupInfo = ref<IGroupItem>({ name: "", path: "", id: "" })
	const refreshing = ref(false)
	const currentSongList = shallowRef<ISongItem[]>([])
	const deleteMenuSongId = ref("")
	const timeOut = ref(0)
	const listScrollTop = ref(0)
	const songItemHeight = 52

	const updateSongList = () => {
		const list : ISongItem[] = mainStore.groupSongArray.find(item => item.groupName == groupInfo.value.name)?.songList ?? []
		let lastList = list
		if (filterValue.value != "") {
			const lowerInput = filterValue.value.toLowerCase()
			lastList = list.filter(item => {
				const lowerName = item.namePinYin as string
				const lowerAuthor = item.authorPinYin as string
				return lowerName.includes(lowerInput) || lowerAuthor.includes(lowerInput)
			})
		}
		// uni-recycle-view 只渲染可视区域，可以一次传入完整列表
		currentSongList.value = lastList
	}

	const handleFilterInput = () => {
		if (timeOut.value != 0) {
			clearTimeout(timeOut.value)
			timeOut.value = 0
		}
		timeOut.value = setTimeout(() => {
			timeOut.value = 0
			updateSongList()
		}, 100)
	}

	// 返回
	const handleBack = () => {
		uni.navigateBack()
	}

	// 显示选择路径弹窗
	const handleChagePath = () => {
		showPathDialog.value = true;
	}

	// 播放歌曲。事件放在虚拟列表插槽内，始终使用当前渲染的 item
	const handlePlayItem = (songData : ISongItem) => {
		if (deleteMenuSongId.value == songData.id) {
			deleteMenuSongId.value = ""
			return
		}
		deleteMenuSongId.value = ""
		setCurrentGroup(groupInfo.value)
		handlePreparePlay(songData, false)
	}

	const handleShowDelete = (songId : string) => {
		deleteMenuSongId.value = songId
	}

	const handleHideDelete = () => {
		deleteMenuSongId.value = ""
	}

	// 加载数据
	async function handleLoadData(offset : number) {
		const limit = 1150
		if (offset == 0) {
			clearDownloadFailedList()
		}
		try {
			let arr = await fetchFolders({ cid: groupInfo.value.id, show_dir: 0, limit, offset });
			arr = arr.filter(item => item["fn"] != null)
			const songList : ISongItem[] = arr.map(item => {
				const nameArray = (item["fn"] as string).split('-');
				const author = nameArray.length > 1 ? nameArray[1] : "未知歌手"
				let ism = item["ism"]
				if (ism != null) {
					ism = ism as string;
				}
				let star = item["star"]
				if (star != null) {
					star = star as string;
				}
				let timeLong = item["play_long"];
				if (timeLong != null) {
					timeLong = timeLong as number
				} else {
					timeLong = 0;
				}
				return {
					name: nameArray[0] as string,
					author,
					id: item["fid"] as string,
					ism,
					pickCode: item["pc"] as string,
					star,
					timeLong
				} as ISongItem;
			});
			setGroupSongMap(groupInfo.value.name, songList, offset > 0)
			if (songList.length === limit) {
				await handleLoadData(offset + limit)
			}
		} catch (err) {
			console.log("获取文件列表失败", err)
			showToast("获取文件列表失败", "error")
			return
		} finally {
			if (offset == 0) {
				updateSongList()
			}
		}
	};

	// 选定路径
	const handlePathSure = (pathArray : IPathStack[]) => {
		showPathDialog.value = false;
		const lastPath = pathArray[pathArray.length - 1];
		const path = pathArray.map(item => item.name).join('/');
		groupInfo.value = { ...groupInfo.value, path, id: lastPath.fid as string } as IGroupItem;
		handleUpdateGroupInfo(groupInfo.value);
		// 获取文件列表
		handleLoadData(0);
	};

	// 下拉刷新
	const handleRefresh = async () => {
		refreshing.value = true
		await handleLoadData(0)
		refreshing.value = false
	}

	// 固定行高下通过 scroll-top 精确定位，避免虚拟列表中目标元素尚未渲染
	const handleScrollToIndex = (index : number) => {
		if (currentSongList.value.length == 0) {
			return
		}
		const lastIndex = currentSongList.value.length - 1
		const safeIndex = Math.max(0, Math.min(index, lastIndex))
		const listElement = uni.getElementById<UniElement>("song-list-viewport")
		const viewportHeight = listElement?.offsetHeight ?? 0
		const centeredTarget = safeIndex * songItemHeight - (viewportHeight - songItemHeight) / 2
		const maxScrollTop = Math.max(0, currentSongList.value.length * songItemHeight - viewportHeight)
		const target = Math.round(Math.max(0, Math.min(centeredTarget, maxScrollTop)))
		// 先改变一次数值，确保重复点击同一定位按钮也能触发滚动
		listScrollTop.value = target == 0 ? 1 : target - 1
		nextTick(() => {
			listScrollTop.value = target
		})
	}

	// 滚动到播放位置
	const handleScrollToPlay = (id : string, force : boolean) => {
		if (id == "") {
			return;
		}
		if (!playStore.autoScrollToPlay && !force) {
			return;
		}
		const index = currentSongList.value.findIndex(item => item.id == id)
		if (index >= 0) {
			handleScrollToIndex(index)
		}
	}

	// 清除过滤
	const handleClearFilter = () => {
		if (timeOut.value != 0) {
			clearTimeout(timeOut.value)
			timeOut.value = 0
		}
		filterValue.value = ""
		updateSongList()
	}

	// 删除
	const handleDeleteItem = async (songData : ISongItem) => {
		deleteMenuSongId.value = ""
		// 从线上删除
		const res = await deleteFile(songData.id, groupInfo.value.id)
		if (res) {
			showToast('删除成功', 'success')
			handleDeleteGroupSong(groupInfo.value.name, songData.id)
			updateSongList()
		}
	}

	// 初始化数据
	onLoad(options => {
		uni.$on(Emit_Name.SCROLL_TO_PLAY as string, handleScrollToPlay)
		const name = options["name"] ?? "";
		const path = options["path"] ?? "";
		const id = options["id"] ?? "";
		groupInfo.value = { name, path, id } as IGroupItem;
		updateSongList()
	})
	onUnload(() => {
		uni.$off(Emit_Name.SCROLL_TO_PLAY as string, handleScrollToPlay)
		if (timeOut.value != 0) {
			clearTimeout(timeOut.value)
			timeOut.value = 0
		}
	})
</script>

<template>
	<view class="play-container safe-area-bottom" @click="handleHideDelete">
		<NavigationBar showLeft showRight title="首页" @leftClick="handleBack" @rightClick="handleChagePath">
			<template #right>
				<uni-icons color="#fff" type="folder-add" size="30"></uni-icons>
			</template>
		</NavigationBar>
		<view class="filter-container">
			<input v-model="filterValue" class="filter-input" placeholder="请输入歌名或歌手" @input="handleFilterInput"></input>
			<uni-icons v-if="filterValue" class="filter-icon" color="#ccc" type="close" size="30"
				@click="handleClearFilter"></uni-icons>
		</view>
		<text class="count-text">共{{ currentSongList.length }}首</text>
		<view id="song-list-viewport" class="list-container">
			<uni-recycle-view class="recycle-list" :list="currentSongList" :itemHeight="songItemHeight"
				:scroll-top="listScrollTop" :refresher-enabled="true" :refresher-triggered="refreshing"
				@refresherrefresh="handleRefresh()">
				<template v-slot:default="{ layoutItems, items }">
					<uni-recycle-item class="list-item" v-for="(item, index) in (items as ISongItem[])"
						:key="(layoutItems as LayoutItem[])[index].id"
						:offset="(layoutItems as LayoutItem[])[index].offset">
						<view class="song-click-area" @click.stop="handlePlayItem(item)">
							<SongItem :song="item"
								:songIndex="Math.floor((layoutItems as LayoutItem[])[index].offset / songItemHeight) + 1"
								:showDelete="deleteMenuSongId == item.id" @showDelete="handleShowDelete(item.id)"
								@hideDelete="handleHideDelete" @delete="handleDeleteItem(item)" />
						</view>
					</uni-recycle-item>
				</template>
			</uni-recycle-view>
		</view>
		<view class="control-container">
			<PlayControl />
		</view>
		<PathDialog v-if="showPathDialog" @close="showPathDialog = false" @sure="handlePathSure" />
		<view class="float-view">
			<view class="aim-button up-button flex-center" hover-class="aim-hover" @click="handleScrollToIndex(0)">
				<Icon class="aim-icon" className="aim-icon" :name="Font_Info.up"></Icon>
			</view>
			<view class="aim-button up-button flex-center" hover-class="aim-hover"
				@click="handleScrollToIndex(currentSongList.length - 1)">
				<Icon class="aim-icon" className="aim-icon" :name="Font_Info.down"></Icon>
			</view>
			<view class="aim-button flex-center" hover-class="aim-hover"
				@click="handleScrollToPlay(playStore.currentSong?.id ?? '', true)">
				<Icon class="aim-icon" className="aim-icon" :name="Font_Info.aim"></Icon>
			</view>
		</view>
	</view>
</template>

<style scoped lang="scss">
	.play-container {
		height: 100%;
		background-color: $bodyBgColor;
		display: flex;
		position: relative;
	}

	.filter-container {
		padding: 4px 10px;
		flex-shrink: 0;
		position: relative;
		;

		.filter-input {
			height: 32px;
			padding: 0 4px;
			border: 1px solid $borderColor;
			border-radius: 4px;
			color: #fff;
		}

		.filter-icon {
			position: absolute;
			right: 14px;
			top: 50%;
			transform: translateY(-50%);
		}
	}

	.count-text {
		padding: 4px 10px;
		color: #ccc;
		font-size: 12px;
	}

	.list-container {
		height: 0;
		padding: 0 10px;
		flex-grow: 1;
		display: flex;
	}

	.recycle-list {
		height: 0;
		flex-grow: 1;
	}

	.list-item {
		height: 52px;
		padding-bottom: 4px;
		box-sizing: border-box;
	}

	.song-click-area {
		width: 100%;
		height: 48px;
	}

	.control-container {
		padding-bottom: 20px;
	}

	.aim-hover {
		background-color: #ddd;
	}

	.float-view {
		display: flex;
		position: fixed;
		bottom: 90px;
		right: 16px;

		.aim-button {
			width: 40px;
			height: 40px;
			padding: 0;
			border-radius: 20px;
			background-color: #fff;

			&.up-button {
				margin-bottom: 10px;
			}
		}

		.aim-icon {
			font-size: 22px;
			font-weight: 400;
		}
	}
</style>
