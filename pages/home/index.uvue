<script setup lang="uts">
	import { IGroupItem } from '../../types';
	import NavigationBar from '@/components/NavigationBar/index.uvue'
	import { mainStore, handleAddGroup, handleDeleteGroup } from "@/store"
	import { showToast } from "@/utils"
	import PlayControl from '@/components/PlayControl/index.uvue'

	const deleteMenuGroupName = ref("")

	// 显示添加分组弹窗
	const handleRightClick = () => {
		uni.showModal({
			title: "添加分组",
			editable: true,
			placeholderText: "请输入分组名称",
			success: (res) => {
				if (res.confirm) {
					if (res.content == null) {
						return;
					}
					const preGroup = mainStore.groupList.find(item => item.name == res.content);
					if (preGroup != null) {
						showToast("分组已存在", null)
					} else {
						handleAddGroup(res.content)
					}
				}
			}
		})
	}

	// 跳转到列表页
	const handleToGroupDetail = (group : IGroupItem) => {
		if (deleteMenuGroupName.value != "") {
			deleteMenuGroupName.value = ""
			return
		}
		uni.navigateTo({
			url: `/pages/playList/playList?name=${group.name}&path=${group.path}&id=${group.id}`,
		})
	}

	// 删除分组
	const handleDelete = (group : IGroupItem) => {
		deleteMenuGroupName.value = ""
		handleDeleteGroup(group.name)
	}

	// 长按分组，显示删除操作
	const handleLongPress = (group : IGroupItem) => {
		deleteMenuGroupName.value = group.name
	}

	const handleHideDelete = () => {
		deleteMenuGroupName.value = ""
	}
</script>

<template>
	<view class="all-container" @click="handleHideDelete">
		<NavigationBar showRight title="首页" @rightClick="handleRightClick">
			<template #right>
				<uni-icons color="#fff" type="plusempty" size="30"></uni-icons>
			</template>
		</NavigationBar>
		<scroll-view class="home-container" @click="handleHideDelete">
			<view class="group-item" v-for="item in mainStore.groupList" :key="item.name"
				@click.stop="handleToGroupDetail(item)" @longpress.stop="handleLongPress(item)">
				<text class="group-name">{{ item.name }}</text>
				<text class="group-path">{{ item.path }}</text>
				<view v-if="deleteMenuGroupName == item.name" class="delete-popover"
					@click.stop="handleDelete(item)">
					<text class="delete-text">删除</text>
				</view>
			</view>
		</scroll-view>
		<view class="control-container">
			<PlayControl />
		</view>
	</view>
</template>

<style scoped lang="scss">
	.all-container {
		height: 100%;
		background-color: $bodyBgColor;
	}

	.home-container {
		flex: 1;
		padding: 8px 10px 0;
	}

	.group-item {
		height: 48px;
		margin-bottom: 8px;
		padding: 2px 10px;
		border: 1px solid $borderColor;
		border-radius: 8px;
		justify-content: center;
		position: relative;

		.group-name {
			color: $navTextColor;
			font-weight: 400;
		}

		.group-path {
			color: #aaa;
			font-size: 12px;
		}
	}

	.delete-popover {
		position: absolute;
		top: 4px;
		right: 8px;
		width: 64px;
		height: 40px;
		border-radius: 6px;
		background-color: $dangerColor;
		align-items: center;
		justify-content: center;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);

		.delete-text {
			color: #ffffff;
			font-size: 14px;
		}
	}

</style>
